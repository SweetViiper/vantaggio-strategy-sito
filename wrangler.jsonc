{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vantaggio-strategy-web",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "vantaggiostrategy.com", "custom_domain": true },
    { "pattern": "www.vantaggiostrategy.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vantaggio-strategy-contatti",
      "database_id": "b7add7ab-504e-4a01-abb6-7fc69f17f4c1",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [{ "name": "MAIL", "destination_address": "marco.mencarini@icloud.com" }],
  "vars": {
    "NOTIFY_TO": "marco.mencarini@icloud.com",
    "NOTIFY_FROM": "modulo@vantaggiostrategy.com"
  },
  "observability": { "enabled": true }
}
